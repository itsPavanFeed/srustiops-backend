# Generate each secret with the command shown. Never commit the filled-in .env.
POSTGRES_PASSWORD=          # openssl rand -hex 24
CENTRAL_MASTER_KEY=         # openssl rand -base64 32   (central: seals its assertion signing key)
TENANT_MASTER_KEY=          # openssl rand -base64 32   (tenant: seals saved plans and its OIDC key)
SRUSTIOPS_STATE_KEY=          # openssl rand -hex 32      (runners derive per-stack state encryption keys)
SRUSTIOPS_PUBLIC_URL=https://localhost:8443
SRUSTIOPS_TENANT=main         # slug of the tenant this install's tenant plane serves
SRUSTIOPS_RUNNER_TOKEN=       # from Tenant settings -> Register runner
SRUSTIOPS_ASSISTANT_API_KEY=  # optional: Anthropic API key; enables the assistant (sends questions and retrieved passages to the API)

# Optional: GitHub App webhooks. Public address GitHub posts to (central), e.g. an ngrok tunnel.
SRUSTIOPS_WEBHOOK_BASE_URL=
# Optional: GitHub App settings. Saved here by the console when the tenant plane runs with SRUSTIOPS_ENV_FILE.
SRUSTIOPS_GITHUB_APP_ID=
SRUSTIOPS_GITHUB_APP_PRIVATE_KEY_FILE=   # path to the app's .pem (relative to this file)
SRUSTIOPS_GITHUB_WEBHOOK_SECRET=         # openssl rand -hex 32; the same value in the app's webhook settings
# Optional: Slack incoming webhook for notifications (Integrations → Slack writes it here with SRUSTIOPS_ENV_FILE).
SRUSTIOPS_SLACK_WEBHOOK_URL=
# Runner: runs executed at the same time by one runner (each in its own folders).
SRUSTIOPS_RUNNER_CONCURRENCY=2
